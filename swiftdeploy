#!/usr/bin/env python3

import argparse
import sys

from config_loader import load_manifest, normalize_manifest
from derived import derive_values
from validation import validate_config
from renderer import render_template


def get_compose_cmd():
    import subprocess

    if subprocess.run(["docker", "compose", "version"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0:
        return ["docker", "compose"]

    if subprocess.run(["docker-compose", "version"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0:
        return ["docker-compose"]

    raise Exception("Neither 'docker compose' nor 'docker-compose' is available")


def cmd_init():
    try:
        manifest = load_manifest()
        config = normalize_manifest(manifest)

        derived = derive_values(config)
        config["derived"] = derived

        validate_config(config)

        docker_compose = render_template("templates/docker-compose.tpl", {
            "app_image": config["app"]["image"],
            "app_container": derived["app_container"],
            "mode": config["app"]["mode"],
            "app_port": config["app"]["port"],
            "app_version": config["app"]["version"],
            "log_volume": derived["log_volume"],
            "nginx_image": config["nginx"]["image"],
            "nginx_container": derived["nginx_container"],
            "nginx_port": config["nginx"]["port"],
            "network_name": config["network"]["name"],
            "network_driver": config["network"]["driver_type"],
            "restart_policy": config["deployment"]["restart_policy"],
        })

        with open("docker-compose.yml", "w") as f:
            f.write(docker_compose)

        nginx_conf = render_template("templates/nginx.conf.tpl", {
            "app_port": config["app"]["port"],
            "proxy_timeout": config["nginx"]["proxy_timeout"],
            "x_deployed_by": config["nginx"]["headers"].get("X-Deployed-By", "swiftdeploy"),
            "error": derived["error_json"]["error"],
            "code": derived["error_json"]["code"],
            "service": derived["error_json"]["service"],
            "contact": derived["error_json"]["contact"],
        })

        with open("nginx.conf", "w") as f:
            f.write(nginx_conf)

        print("✔ Configuration files generated successfully.")

    except Exception as e:
        print(f"✖ init failed: {e}")
        sys.exit(1)


def cmd_validate():
    import os
    import subprocess
    import socket

    try:
        print("Running validation checks...\n")

        if not os.path.exists("manifest.yml"):
            raise Exception("manifest.yml not found")
        print("✔ Manifest file exists")

        try:
            manifest = load_manifest()
        except Exception:
            raise Exception("Invalid YAML in manifest.yml")
        print("✔ Manifest is valid YAML")

        config = normalize_manifest(manifest)
        config["derived"] = derive_values(config)

        validate_config(config)
        print("✔ Required fields are present and valid")

        image = config["app"]["image"]
        result = subprocess.run(
            ["docker", "image", "inspect", image],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL
        )

        if result.returncode != 0:
            print(f"⚠ Docker image not found locally: {image} (skipping for now)")
        else:
            print("✔ Docker image exists locally")

        port = int(config["nginx"]["port"])
        sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)

        try:
            sock.bind(("0.0.0.0", port))
        except OSError:
            raise Exception(f"Port {port} is already in use")
        finally:
            sock.close()

        print("✔ Nginx port is available")

        if not os.path.exists("nginx.conf"):
            print("ℹ nginx.conf not found, generating via init...")
            cmd_init()

        result = subprocess.run(
            ["nginx", "-t", "-c", os.path.abspath("nginx.conf")],
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE
        )

        if result.returncode != 0:
            raise Exception("nginx.conf is invalid:\n" + result.stderr.decode())

        print("✔ nginx.conf is syntactically valid\n")
        print("All validation checks passed.")

    except Exception as e:
        print(f"✖ Validation failed: {e}")
        sys.exit(1)


def cmd_deploy():
    import subprocess
    import time
    import requests

    try:
        print("Starting deployment...\n")

        cmd_init()

        compose_cmd = get_compose_cmd()

        subprocess.run(
            compose_cmd + ["up", "-d"],
            check=True
        )
        print("✔ Containers started")

        manifest = load_manifest()
        config = normalize_manifest(manifest)
        config["derived"] = derive_values(config)

        port = config["nginx"]["port"]
        health_url = f"http://localhost:{port}/healthz"

        timeout = config["deployment"]["health_check_timeout"] or 60
        start_time = time.time()

        time.sleep(3)

        print(f"Waiting for service to become healthy ({timeout}s timeout)...")

        while time.time() - start_time < timeout:
            try:
                response = requests.get(health_url, timeout=2)
                if response.status_code == 200:
                    print("✔ Service is healthy")
                    return
                else:
                    print(f"Waiting... status={response.status_code}")
            except Exception:
                print("Waiting... connection not ready")

            time.sleep(2)

        raise Exception("Service did not become healthy within timeout")

    except Exception as e:
        print(f"✖ Deployment failed: {e}")
        try:
            compose_cmd = get_compose_cmd()
            subprocess.run(compose_cmd + ["down"])
        except:
            pass
        sys.exit(1)


def cmd_teardown():
    import subprocess

    try:
        compose_cmd = get_compose_cmd()
        subprocess.run(compose_cmd + ["down", "-v"], check=True)
        print("✔ All resources removed")
    except Exception as e:
        print(f"✖ Teardown failed: {e}")
        sys.exit(1)


def cmd_promote(mode):
    import subprocess
    import yaml
    import time
    import requests

    try:
        with open("manifest.yml", "r") as f:
            manifest = yaml.safe_load(f)

        manifest["services"]["mode"] = mode
        manifest["deployment"]["strategy"] = mode

        with open("manifest.yml", "w") as f:
            yaml.dump(manifest, f)

        print(f"✔ Manifest updated to {mode}")

        cmd_init()

        compose_cmd = get_compose_cmd()

        subprocess.run(
            compose_cmd + ["up", "-d", "--no-deps", "app"],
            check=True
        )

        print("✔ App container restarted")

        port = manifest["nginx"]["port"]
        url = f"http://localhost:{port}/healthz"

        time.sleep(3)

        for _ in range(30):
            try:
                r = requests.get(url, timeout=2)
                if r.status_code == 200:
                    print(f"✔ Service now running in {mode}")
                    return
            except:
                pass
            time.sleep(2)

        raise Exception("Health check failed after promote")

    except Exception as e:
        print(f"✖ Promote failed: {e}")
        sys.exit(1)


def main():
    parser = argparse.ArgumentParser(prog="swiftdeploy")
    subparsers = parser.add_subparsers(dest="command")

    subparsers.add_parser("init")
    subparsers.add_parser("validate")
    subparsers.add_parser("deploy")
    subparsers.add_parser("teardown")

    promote_parser = subparsers.add_parser("promote")
    promote_parser.add_argument("mode", choices=["stable", "canary"])

    args = parser.parse_args()

    if args.command == "init":
        cmd_init()
    elif args.command == "validate":
        cmd_validate()
    elif args.command == "deploy":
        cmd_deploy()
    elif args.command == "teardown":
        cmd_teardown()
    elif args.command == "promote":
        cmd_promote(args.mode)
    else:
        parser.print_help()


if __name__ == "__main__":
    main()
